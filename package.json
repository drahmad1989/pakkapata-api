{
  "name": "pakkapata",
  "version": "0.10.10",
  "description": "Sovereign, self-hosted digital addressing infrastructure for Pakistan. Maps every physical entrance using Uber H3 hexagonal grid with permanent spatial identity (UPRN + short code).",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:pakistan": "node scripts/seed-pakistan.js"
  },
  "keywords": [
    "addressing",
    "pakistan",
    "h3",
    "plus-code",
    "uprn",
    "gis",
    "spatial",
    "sovereign"
  ],
  "author": "GeoPata Project",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "h3-js": "^4.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "open-location-code": "^1.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "allowScripts": {
    "better-sqlite3@12.4.1": true
  }
}
